// Shared VERSIONINFO of ghostty.exe and tmux.exe. The per-exe values come
// from ghostty_version.h, which the build generates (windows_version.zig).
// Numeric literals keep this free of winver.h under either ABI.
#include "ghostty_version.h"

1 VERSIONINFO                           // VS_VERSION_INFO
FILEVERSION     GHOSTTY_FILEVERSION
PRODUCTVERSION  GHOSTTY_FILEVERSION
FILEFLAGSMASK   0x3FL                 // VS_FFI_FILEFLAGSMASK
FILEFLAGS       GHOSTTY_FILEFLAGS     // VS_FF_PRERELEASE | VS_FF_DEBUG
FILEOS          0x40004L              // VOS_NT_WINDOWS32
FILETYPE        0x1L                  // VFT_APP
FILESUBTYPE     0x0L                  // VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  GHOSTTY_FILE_DESCRIPTION
            VALUE "FileVersion",      GHOSTTY_VERSION_STR
            VALUE "InternalName",     GHOSTTY_ORIGINAL_FILENAME
            VALUE "LegalCopyright",   "Copyright (c) 2024 Mitchell Hashimoto, Ghostty contributors"
            VALUE "OriginalFilename", GHOSTTY_ORIGINAL_FILENAME
            VALUE "ProductName",      "Ghostty — Unofficial Windows port"
            VALUE "ProductVersion",   GHOSTTY_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
